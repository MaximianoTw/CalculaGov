<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="20dp"
    android:paddingHorizontal="20dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/imgDeleteDialogIcon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_icon_soft_red"
        android:padding="14dp"
        android:src="@drawable/ic_delete"
        app:tint="#D32F2F" />

    <TextView
        android:id="@+id/textDeleteDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="Excluir registro?"
        android:textColor="#1F1F1F"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textDeleteDialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Este cálculo será removido do histórico."
        android:textColor="@color/gov_text_gray"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/textDeleteDialogDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#F8F9FA"
        android:lineSpacingExtra="3dp"
        android:padding="14dp"
        android:textColor="@color/gov_text_gray"
        android:textSize="13sp" />
</LinearLayout>
