<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gov_gray_light"
    tools:context=".CalculoImpostoRendaActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gov_blue">
        <androidx.appcompat.widget.Toolbar
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gov_br"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F0F2F5"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="8dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/simulador_ir_title"
                        android:textColor="#000000"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/simulador_subtitle"
                        android:textColor="#5F6368"
                        android:textSize="14sp" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        app:cardBackgroundColor="#E8EAED"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp">

                        <com.google.android.material.tabs.TabLayout
                            android:id="@+id/tabLayoutPeriodo"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_margin="4dp"
                            android:background="@android:color/transparent"
                            app:tabBackground="@drawable/tab_selector_rounded"
                            app:tabIndicatorHeight="0dp"
                            app:tabRippleColor="@android:color/transparent"
                            app:tabSelectedTextColor="@color/white"
                            app:tabTextColor="@color/gov_blue"
                            app:tabTextAppearance="@style/CustomTabText">

                            <com.google.android.material.tabs.TabItem
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/simulacao_mensal" />

                            <com.google.android.material.tabs.TabItem
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/simulacao_anual" />
                        </com.google.android.material.tabs.TabLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- TELA 1: SIMULAÇÃO MENSAL -->
                    <LinearLayout
                        android:id="@+id/layoutMensal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <Button
                            android:id="@+id/btnAutoPreencherMensal"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="16dp"
                            android:text="@string/preencher_perfil"
                            android:textAllCaps="false"
                            android:textColor="@color/gov_blue"
                            app:cornerRadius="8dp"
                            app:icon="@drawable/ic_profile"
                            app:iconTint="@color/gov_blue" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:text="@string/pergunta_renda_mensal"
                            android:textColor="#000000"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/legenda_renda_mensal"
                            android:textColor="#757575"
                            android:textSize="11sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/edit_text_rounded_outline"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/editTextRendaMensal"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@android:color/transparent"
                                android:inputType="numberDecimal"
                                android:hint="@string/hint_renda_mensal" />

                            <ImageButton
                                android:id="@+id/btnEvidenciaRendaMensal"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_icon_soft_blue"
                                android:contentDescription="Anexar comprovante"
                                android:padding="8dp"
                                android:src="@drawable/ic_camera"
                                app:tint="@color/gov_blue" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/pergunta_inss_mensal"
                            android:textColor="#000000"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/legenda_inss_mensal"
                            android:textColor="#757575"
                            android:textSize="11sp" />

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editTextPrevidenciaMensal"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/edit_text_rounded_outline"
                            android:inputType="numberDecimal"
                            android:paddingHorizontal="16dp"
                            android:hint="@string/hint_inss_mensal" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/pergunta_dep_mensal"
                            android:textColor="#000000"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/legenda_dep_mensal"
                            android:textColor="#757575"
                            android:textSize="11sp" />

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editTextDepMensal"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/edit_text_rounded_outline"
                            android:inputType="number"
                            android:paddingHorizontal="16dp"
                            android:hint="@string/hint_dep_mensal" />

                        <Button
                            android:id="@+id/btnCalcularMensal"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="24dp"
                            android:backgroundTint="@color/gov_blue"
                            android:text="@string/btn_calcular_mensal"
                            android:textAllCaps="false"
                            android:visibility="gone"
                            app:cornerRadius="8dp" />
                    </LinearLayout>

                    <!-- TELA 2: SIMULAÇÃO ANUAL (COMPLETA) -->
                    <LinearLayout
                        android:id="@+id/layoutAnual"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:text="@string/pergunta_renda_anual"
                            android:textColor="#000000"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/legenda_renda_anual"
                            android:textColor="#757575"
                            android:textSize="11sp" />

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editTextRendaAnual"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/edit_text_rounded_outline"
                            android:inputType="numberDecimal"
                            android:paddingHorizontal="16dp"
                            android:hint="@string/hint_renda_anual" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/pergunta_inss_anual"
                            android:textColor="#000000"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/legenda_inss_anual"
                            android:textColor="#757575"
                            android:textSize="11sp" />

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editTextPrevidenciaAnual"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/edit_text_rounded_outline"
                            android:inputType="numberDecimal"
                            android:paddingHorizontal="16dp"
                            android:hint="@string/hint_inss_anual" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/pergunta_dep_mensal"
                            android:textColor="#000000"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/legenda_dep_mensal"
                            android:textColor="#757575"
                            android:textSize="11sp" />

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editTextDepAnual"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/edit_text_rounded_outline"
                            android:inputType="number"
                            android:paddingHorizontal="16dp"
                            android:hint="@string/hint_dep_mensal" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/pergunta_saude_anual"
                            android:textColor="#000000"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/legenda_saude_anual"
                            android:textColor="#757575"
                            android:textSize="11sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/edit_text_rounded_outline"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/editTextSaudeAnual"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@android:color/transparent"
                                android:inputType="numberDecimal"
                                android:hint="@string/hint_saude_anual" />

                            <ImageButton
                                android:id="@+id/btnEvidenciaSaudeAnual"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_icon_soft_blue"
                                android:contentDescription="Anexar comprovante"
                                android:padding="8dp"
                                android:src="@drawable/ic_camera"
                                app:tint="@color/gov_blue" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/pergunta_edu_anual"
                            android:textColor="#000000"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/legenda_edu_anual"
                            android:textColor="#757575"
                            android:textSize="11sp" />

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editTextEduAnual"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/edit_text_rounded_outline"
                            android:inputType="numberDecimal"
                            android:paddingHorizontal="16dp"
                            android:hint="@string/hint_edu_anual" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/pergunta_pensao_anual"
                            android:textColor="#000000"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/legenda_pensao_anual"
                            android:textColor="#757575"
                            android:textSize="11sp" />

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editTextPensaoAnual"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/edit_text_rounded_outline"
                            android:inputType="numberDecimal"
                            android:paddingHorizontal="16dp"
                            android:hint="@string/hint_pensao_anual" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/pergunta_irrf_anual"
                            android:textColor="#000000"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/legenda_irrf_anual"
                            android:textColor="#757575"
                            android:textSize="11sp" />

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editTextIRRFAnual"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/edit_text_rounded_outline"
                            android:inputType="numberDecimal"
                            android:paddingHorizontal="16dp"
                            android:hint="@string/hint_irrf_anual" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/buttonCalcular"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="32dp"
                        android:backgroundTint="@color/gov_blue"
                        android:text="@string/btn_calcular_anual"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        app:cornerRadius="8dp" />

                    <!-- NOVO: CARD DE COMPARAÇÃO DE MODELOS -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardComparativo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:visibility="gone"
                        app:cardBackgroundColor="#F8F9FA"
                        app:cardCornerRadius="12dp"
                        app:strokeColor="#DEE2E6"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="MELHOR OPÇÃO PARA VOCÊ"
                                android:textColor="@color/gov_blue"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Simplificada"
                                        android:textSize="12sp" />
                                    <TextView
                                        android:id="@+id/textResultadoSimplificado"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="R$ 0,00"
                                        android:textColor="#000000"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <View
                                    android:layout_width="1dp"
                                    android:layout_height="match_parent"
                                    android:layout_marginHorizontal="16dp"
                                    android:background="#DEE2E6" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Completa"
                                        android:textSize="12sp" />
                                    <TextView
                                        android:id="@+id/textResultadoCompleto"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="R$ 0,00"
                                        android:textColor="#000000"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </LinearLayout>

                            <TextView
                                android:id="@+id/textDicaEconomia"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:background="#E7F3FF"
                                android:padding="8dp"
                                android:text="Analisando as melhores opções para sua economia..."
                                android:textColor="#0056B3"
                                android:textSize="12sp"
                                android:textStyle="italic" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- RESULTADO DETALHADO -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardUltimoResultado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="8dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/parecer_titulo"
                        android:textColor="#000000"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textResumoResultado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="4dp"
                        android:textColor="#5F6368"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/buttonDownloadPDF"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="24dp"
                        android:backgroundTint="#E8F0FE"
                        android:text="@string/btn_pdf"
                        android:textAllCaps="false"
                        android:textColor="@color/gov_blue"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:cornerRadius="8dp"
                        app:icon="@drawable/ic_documents"
                        app:iconPadding="12dp"
                        app:iconTint="@color/gov_blue" />

                    <Button
                        android:id="@+id/buttonSalvarCalculo"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="12dp"
                        android:backgroundTint="#FFF9C4"
                        android:text="SALVAR CÁLCULO NO HISTÓRICO"
                        android:textAllCaps="false"
                        android:textColor="#856404"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:cornerRadius="8dp"
                        app:icon="@drawable/ic_history"
                        app:iconPadding="12dp"
                        app:iconTint="#856404" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Button
                android:id="@+id/VoltarHome"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="60dp"
                android:text="@string/btn_voltar_menu"
                android:textColor="#5F6368" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/white"
        app:itemIconTint="@color/gov_blue"
        app:itemTextColor="@color/gov_blue"
        app:menu="@menu/bottom_nav_menu" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
