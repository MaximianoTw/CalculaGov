<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".CalculoImpostoRendaActivity">

    <TextView
        android:id="@+id/textViewRenda"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Renda Mensal (R$):"
        android:textSize="16sp"
        tools:ignore="MissingConstraints" />

    <EditText
        android:id="@+id/editTextRenda"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Informe sua renda mensal"
        android:inputType="numberDecimal"
        tools:ignore="MissingConstraints" />

    <TextView
        android:id="@+id/textViewDeducoes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Deduções (R$):"
        android:textSize="16sp"
        tools:ignore="MissingConstraints" />

    <EditText
        android:id="@+id/editTextDeducoes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Informe suas deduções"
        android:inputType="numberDecimal"
        tools:ignore="MissingConstraints" />

    <Button
        android:id="@+id/buttonCalcular"
        android:layout_width="366dp"
        android:layout_height="wrap_content"
        android:onClick="calcularImposto"
        android:text="Calcular Imposto"
        tools:ignore="MissingConstraints" />

    <Button
        android:id="@+id/VoltarHome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="voltar" />


</LinearLayout>
