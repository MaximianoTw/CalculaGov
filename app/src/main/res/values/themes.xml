<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.CalcGov" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/gov_blue</item>
        <item name="colorPrimaryVariant">@color/gov_blue_darker</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/gov_gold</item>
        <item name="colorSecondaryVariant">@color/gov_gold</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/gov_blue</item>
        <!-- Customize your theme here. -->
        <item name="android:windowBackground">@color/gov_gray_light</item>
    </style>

    <style name="Theme.CalcGov" parent="Base.Theme.CalcGov" />

    <style name="CustomTabText" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>